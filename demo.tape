# mdx demo recording
Output demo.gif

Set Shell "bash"
Set FontSize 14
Set Width 960
Set Height 600
Set Theme "Dracula"
Set TypingSpeed 50ms

# Launch mdx
Type "mdx demo.md"
Enter
Sleep 2s

# Scroll down slowly
Sleep 500ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 1s

# Switch theme
Type "t"
Sleep 1.5s
Type "t"
Sleep 1.5s
Type "t"
Sleep 1.5s

# Search
Type "/"
Sleep 300ms
Type "rust"
Sleep 1s
Enter
Sleep 1s

# Clear and scroll back
Escape
Sleep 500ms

# Go to top
Type "gg"
Sleep 1s

# Show help
Type "?"
Sleep 2s
Type "?"
Sleep 500ms

# Quit
Type "q"
Sleep 500ms
